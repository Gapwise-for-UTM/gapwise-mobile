# Public configuration only. Never put service-role keys, OAuth client secrets,
# encryption keys, or other privileged secrets in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_GAPWISE_API_BASE_URL=https://api.gapwise.ca/v1
EXPO_PUBLIC_GAPWISE_CHANNEL=development
EXPO_PUBLIC_GAPWISE_COMMIT_SHA=local

# Optional public Supabase client configuration for account continuity.
# Use only the project URL and publishable/anon client key. Never use service_role.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
