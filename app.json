{
  "expo": {
    "name": "Gapwise",
    "slug": "gapwise-mobile",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "scheme": "gapwise",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ca.gapwise.mobile",
      "buildNumber": "1"
    },
    "android": {
      "package": "ca.gapwise.mobile",
      "versionCode": 1
    },
    "extra": {
      "apiBaseUrl": "https://api.gapwise.ca/v1"
    }
  }
}
