{
  "name": "gapwise-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/theme.test.mjs",
    "format:check": "prettier --check .",
    "doctor": "npx expo-doctor@latest",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "export:android": "expo export --platform android --output-dir dist/android",
    "check": "npm run typecheck && npm test && npm run format:check"
  },
  "dependencies": {
    "expo": "~57.0.0",
    "expo-constants": "~57.0.14",
    "expo-device": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.16",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
